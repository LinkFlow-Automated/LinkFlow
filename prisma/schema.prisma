// Multi-tenant Prisma schema with Profile support
// Users can now have multiple profiles (like Linktree)

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Waitlist {
  id        String   @id @default(cuid())
  email     String   @unique
  position  Int
  createdAt DateTime @default(now())

  @@map("waitlist")
}

model User {
  id               String    @id
  name             String
  email            String    @unique
  emailVerified    Boolean
  image            String?
  createdAt        DateTime
  updatedAt        DateTime
  stripeCustomerId String?
  stripeAccountId  String?
  role             String?
  banned           Boolean?
  banReason        String?
  banExpires       DateTime?

  sessions         Session[]
  accounts         Account[]
  profiles         Profile[] // 🆕 User can have multiple profiles
  apikeys          Apikey[]
  members          Member[]
  invitations      Invitation[]
  providerAccounts ProviderAcc[]

  @@map("user")
}

// 🆕 Profile model - the core of multi-tenancy
model Profile {
  id          String  @id @default(cuid())
  userId      String
  username    String  @unique // Each profile has unique username/slug
  displayName String? // Display name for the profile
  bio         String?
  image       String? // Profile-specific avatar
  slug        String  @unique

  // Profile customization
  isPrimary    Boolean @default(false) // User's main/default profile
  isPublic     Boolean @default(true) // Profile visibility
  customDomain String? @unique // Optional custom domain

  // Branding
  backgroundColor String?
  textColor       String?
  buttonStyle     String?
  fontFamily      String?

  // SEO & Meta
  metaTitle       String?
  metaDescription String?
  metaImage       String?

  // Social links (optional, separate from Link items)
  socialLinks Json?

  // Analytics
  views       Int @default(0)
  totalClicks Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  links         Link[]
  themes        Theme[]
  avatarBorders ProfileAvatarBorder[]
  clickEvents   ClickEvent[]

  @@index([userId])
  @@index([username])
  @@index([customDomain])
  @@map("profile")
}

model AvatarBorder {
  id         String   @id @default(cuid())
  name       String
  type       String // "static" | "animated"
  previewUrl String
  config     Json // shape, thickness, colors, animation
  rarity     String // "common" | "rare" | "epic" | "legendary"
  price      Float?
  currency   String? // "USD" | "CREDITS"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  profiles ProfileAvatarBorder[]

  @@map("avatar_border")
}

// 🔄 Changed from UserAvatarBorder to ProfileAvatarBorder
model ProfileAvatarBorder {
  id        String  @id @default(cuid())
  profileId String
  borderId  String
  owned     Boolean @default(false)
  equipped  Boolean @default(false)

  profile Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  border  AvatarBorder @relation(fields: [borderId], references: [id])

  @@unique([profileId, borderId])
  @@map("profile_avatar_border")
}

model Theme {
  id          String  @id @default(cuid())
  name        String
  description String?
  settings    Json

  type      ThemeType @default(USER)
  isPublic  Boolean   @default(false)
  isDefault Boolean   @default(false)

  // 🔄 Changed from userId to profileId
  profileId String?
  profile   Profile? @relation(fields: [profileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("theme")
}

model Link {
  id                String         @id @default(cuid())
  profileId         String // 🔄 Changed from userId to profileId
  title             String
  description       String?
  url               String
  isHadRedirectLink Boolean        @default(false)
  redirectTo        String?
  category          String?
  order             Int
  clicks            Int            @default(0)
  featured          Boolean        @default(false)
  autoSyncId        String?
  platform          String?
  thumbnail         String?
  type              ThumbnailType?
  isArchived        Boolean        @default(false)
  visibility        Visibility     @default(PUBLIC)
  scheduledAt       DateTime?
  expiresAt         DateTime?
  rules             Json?

  // Presentation layer
  layout         String?
  animation      String?
  themeOverrides Json?
  metadata       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile     Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  clickEvents ClickEvent[]

  @@index([profileId, order])
  @@index([profileId, autoSyncId])
  @@map("link")
}

model ClickEvent {
  id        String  @id @default(cuid())
  linkId    String
  profileId String? // 🆕 Optional: track which profile received the click
  userAgent String
  geo       Json?
  device    String?
  browser   String?
  os        String?

  timestamp DateTime @default(now())

  // Tracking info
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  referrer    String?

  link    Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)
  profile Profile? @relation(fields: [profileId], references: [id], onDelete: SetNull)

  // Composite indexes cover the analytics access pattern (scope + time range,
  // ordered by timestamp) and also serve the leading-column-only lookups.
  @@index([linkId, timestamp])
  @@index([profileId, timestamp])
  @@map("click_event")
}

model ProviderAcc {
  id                String    @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  accessToken       String
  refreshToken      String?
  expiresAt         DateTime?
  scope             String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, userId])
  @@map("provider_account")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime
  updatedAt      DateTime
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  activeOrganizationId String?

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model Apikey {
  id                  String    @id
  name                String?
  start               String?
  prefix              String?
  key                 String
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refillInterval      Int?
  refillAmount        Int?
  lastRefillAt        DateTime?
  enabled             Boolean?
  rateLimitEnabled    Boolean?
  rateLimitTimeWindow Int?
  rateLimitMax        Int?
  requestCount        Int?
  remaining           Int?
  lastRequest         DateTime?
  expiresAt           DateTime?
  createdAt           DateTime
  updatedAt           DateTime
  permissions         String?
  metadata            String?

  @@map("apikey")
}

model OauthApplication {
  id           String    @id
  name         String?
  icon         String?
  metadata     String?
  clientId     String?   @unique
  clientSecret String?
  redirectURLs String?
  type         String?
  disabled     Boolean?
  userId       String?
  createdAt    DateTime?
  updatedAt    DateTime?

  @@map("oauthApplication")
}

model OauthAccessToken {
  id                    String    @id
  accessToken           String?   @unique
  refreshToken          String?   @unique
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  clientId              String?
  userId                String?
  scopes                String?
  createdAt             DateTime?
  updatedAt             DateTime?

  @@map("oauthAccessToken")
}

model OauthConsent {
  id           String    @id
  clientId     String?
  userId       String?
  scopes       String?
  createdAt    DateTime?
  updatedAt    DateTime?
  consentGiven Boolean?

  @@map("oauthConsent")
}

model Organization {
  id          String       @id
  name        String
  slug        String?      @unique
  logo        String?
  createdAt   DateTime
  metadata    String?
  members     Member[]
  invitations Invitation[]

  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String
  createdAt      DateTime

  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String
  expiresAt      DateTime
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@map("invitation")
}

enum Visibility {
  PUBLIC
  PRIVATE
  SCHEDULED
}

enum ThemeType {
  USER
  SYSTEM
  SHARED
}

enum ThumbnailType {
  icon
  image
}
